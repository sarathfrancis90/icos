<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links for /join/{code} and /puzzle/{date}; requires
	     https://icos.app/.well-known/apple-app-site-association -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:icos.app</string>
	</array>
	<!-- Push notifications (Firebase Messaging). Xcode/fastlane rewrites this
	     to "production" automatically for App Store / TestFlight exports. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
