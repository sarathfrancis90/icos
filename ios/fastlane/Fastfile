default_platform(:ios)

APP_ID = "com.icos.game".freeze
REPO_ROOT = File.expand_path("../..", __dir__).freeze

platform :ios do
  # ---------------------------------------------------------------------------
  # Helpers
  # ---------------------------------------------------------------------------
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      duration: 1200,
      in_house: false
    )
  end

  desc "Sync App Store certificates and profiles via match (read-only on CI)"
  lane :sync_certs do
    match(type: "appstore", readonly: is_ci)
  end

  # ---------------------------------------------------------------------------
  # beta: build once with manual signing (match) and upload to TestFlight
  # ---------------------------------------------------------------------------
  desc "Build the Flutter app and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    sync_certs

    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_ID]
    UI.user_error!("match did not return a profile for #{APP_ID}") if profile_name.nil?

    # Manual signing with the match-provisioned profile. We do NOT pass
    # -allowProvisioningUpdates: CI must never touch the developer portal.
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: APP_ID,
      entitlements_file_path: "Runner/Runner.entitlements"
    )

    # Compile Dart/Flutter first (no codesign); build_app then archives + signs.
    Dir.chdir(REPO_ROOT) do
      sh(
        "flutter", "build", "ios",
        "--release",
        "--no-codesign",
        "--obfuscate",
        "--split-debug-info=build/ios/symbols",
        "--dart-define-from-file=.env.production"
      )
    end

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(REPO_ROOT, "build/ios/ipa"),
      output_name: "Runner.ipa",
      include_symbols: true,
      include_bitcode: false,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  # ---------------------------------------------------------------------------
  # release: promote an already-uploaded build with App Store metadata
  # ---------------------------------------------------------------------------
  desc "Submit an existing TestFlight build for App Store review (metadata from fastlane/metadata)"
  lane :release do |options|
    api_key = asc_api_key

    deliver(
      api_key: api_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: !File.directory?(File.join(__dir__, "metadata")),
      metadata_path: "./metadata",
      build_number: options[:build_number],   # optional: pick a specific build
      submit_for_review: true,
      automatic_release: false,               # release manually from ASC after approval
      force: true,                            # skip the HTML preview prompt (CI-safe)
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
