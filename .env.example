# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Native sign-in (optional; web OAuth fallback is used when empty)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Firebase (optional; analytics/crashlytics/push are disabled when empty)
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=com.icos.game

# Google Sign-In OAuth client IDs (Google Cloud Console > Credentials)
#   Web client ID  -> used as serverClientId on Android and for Supabase's Google provider
#   iOS client ID  -> also reversed into ios/Runner/Info.plist CFBundleURLSchemes
GOOGLE_WEB_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# Firebase (optional; values from the Firebase console > Project settings).
# Leave empty to run without Firebase. google-services.json / GoogleService-Info.plist
# are git-ignored and injected by CI from secrets when present.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
